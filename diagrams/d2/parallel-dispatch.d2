# Parallel Agent Dispatch
# 7 agents running concurrently during Phase 2
# Theatre Detector runs first, feeds Test Coverage Analyzer

direction: down

title: PARALLEL AGENT DISPATCH {
  style.fill: "#f8f9fa"
  style.stroke: "#dee2e6"
  style.font-size: 16
  style.bold: true
}

context: Context Package {
  style.fill: "#f8f9fa"
  style.stroke: "#dee2e6"
  items: |md
    - Staged diff
    - Related files
    - Project context
    - Documentation
  |
}

agents: {
  label: "7 Agents (Parallel with Dependency)"
  style.fill: "#f8f9fa"
  style.stroke: "#0d6efd"
  style.stroke-width: 2

  security: Security\nAnalyst {
    style.fill: "#dc3545"
    style.font-color: white
  }
  architecture: Architecture\nReviewer {
    style.fill: "#0d6efd"
    style.font-color: white
  }
  correctness: Correctness\nVerifier {
    style.fill: "#dc3545"
    style.font-color: white
  }
  performance: Performance\nAuditor {
    style.fill: "#fd7e14"
    style.font-color: white
  }
  theatre: Test Theatre\nDetector {
    style.fill: "#e67e22"
    style.font-color: white
  }
  test: Test Coverage\nAnalyzer {
    style.fill: "#198754"
    style.font-color: white
  }
  style_check: Code\nStyle {
    style.fill: "#0d6efd"
    style.font-color: white
  }

  # Dependency: Theatre detector feeds coverage analyzer
  theatre -> test: "theatre list" {
    style.stroke: "#e67e22"
    style.stroke-width: 2
  }
}

dependency_note: {
  label: |md
    **Dependency Note**
    Theatre Detector runs first (or in parallel)
    and provides a list of theatre tests to
    Test Coverage Analyzer for validation.
  |
  style.fill: "#fff3cd"
  style.stroke: "#e67e22"
  style.font-size: 11
  near: bottom-left
}

collect: Collect Results {
  style.fill: "#198754"
  style.font-color: white
  style.border-radius: 8
}

title -> context
context -> agents
agents -> collect: JSON Reports
