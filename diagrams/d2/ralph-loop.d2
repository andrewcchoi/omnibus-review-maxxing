# Ralph Loop Fix Cycle - Parallel Subagent Architecture
# Phase 4: Iterative fixing with context isolation

direction: down

# ========== PLANNING ==========
planning: Planning Phase {
  style.fill: "#dbeafe"
  style.stroke: "#3b82f6"

  group: Group findings by file {
    style.fill: "#eff6ff"
  }

  plans: Generate fix plans {
    style.fill: "#eff6ff"
    label: "Generate YAML fix plans\n(one per file)"
  }

  group -> plans
}

# ========== PARALLEL FIXERS ==========
fix_phase: Fix Phase (Parallel Subagents) {
  style.fill: "#fce7f3"
  style.stroke: "#ec4899"

  dispatch_fix: Dispatch fixers {
    shape: hexagon
    style.fill: "#f9a8d4"
    label: "Spawn parallel\nomnibus-fixer agents"
  }

  fixers: {
    style.fill: "#fdf2f8"

    fixer_a: "Fixer: file-A.py" {
      shape: person
      style.fill: "#f472b6"
    }
    fixer_b: "Fixer: file-B.py" {
      shape: person
      style.fill: "#f472b6"
    }
    fixer_c: "Fixer: file-C.py" {
      shape: person
      style.fill: "#f472b6"
    }
  }

  collect_fix: Collect updated plans {
    style.fill: "#fbcfe8"
  }

  dispatch_fix -> fixers.fixer_a
  dispatch_fix -> fixers.fixer_b
  dispatch_fix -> fixers.fixer_c
  fixers.fixer_a -> collect_fix
  fixers.fixer_b -> collect_fix
  fixers.fixer_c -> collect_fix
}

# ========== PARALLEL VALIDATORS ==========
validate_phase: Validation Phase (Parallel Subagents) {
  style.fill: "#d1fae5"
  style.stroke: "#10b981"

  dispatch_val: Dispatch validators {
    shape: hexagon
    style.fill: "#6ee7b7"
    label: "Spawn parallel\nomnibus-validator agents"
  }

  validators: {
    style.fill: "#ecfdf5"

    val_a: "Validator: file-A.py" {
      shape: person
      style.fill: "#34d399"
    }
    val_b: "Validator: file-B.py" {
      shape: person
      style.fill: "#34d399"
    }
    val_c: "Validator: file-C.py" {
      shape: person
      style.fill: "#34d399"
    }
  }

  collect_val: Collect validation reports {
    style.fill: "#a7f3d0"
  }

  dispatch_val -> validators.val_a
  dispatch_val -> validators.val_b
  dispatch_val -> validators.val_c
  validators.val_a -> collect_val
  validators.val_b -> collect_val
  validators.val_c -> collect_val
}

# ========== RE-REVIEW ==========
rereview: Re-Review Phase {
  style.fill: "#e0e7ff"
  style.stroke: "#6366f1"

  run: Run 6 review agents {
    style.fill: "#c7d2fe"
    label: "Run review agents\non modified files only"
  }

  findings: New findings {
    shape: document
    style.fill: "#a5b4fc"
  }

  run -> findings
}

# ========== DECISION ==========
decision: CRITICAL/HIGH remain? {
  shape: diamond
  style.fill: "#fef3c7"
  style.stroke: "#f59e0b"
}

max_check: Max iterations? {
  shape: diamond
  style.fill: "#fee2e2"
  style.stroke: "#ef4444"
}

# ========== OUTCOMES ==========
success: Done - All resolved {
  shape: oval
  style.fill: "#d1fae5"
  style.stroke: "#10b981"
  style.stroke-width: 3
}

max_exit: Done - Max iterations {
  shape: oval
  style.fill: "#fee2e2"
  style.stroke: "#ef4444"
  style.stroke-width: 2
  label: "Done - Max iterations\nManual review needed"
}

# ========== CONNECTIONS ==========
planning -> fix_phase
fix_phase -> validate_phase
validate_phase -> rereview
rereview -> decision

decision -> success: No
decision -> max_check: Yes

max_check -> max_exit: Yes
max_check -> planning: No {
  style.stroke: "#ef4444"
  style.stroke-width: 3
  label: "Loop with\nnew findings"
}

# ========== LEGEND ==========
legend: {
  style.fill: "#f3f4f6"
  near: bottom-right

  label: |md
    **Context Isolation**
    Each subagent starts fresh:
    - Fixer: file + plan only
    - Validator: plan + diff only
    - No compaction needed
  |
}
