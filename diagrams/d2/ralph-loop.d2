# Ralph Loop Fix Cycle
# Phase 4: Iterative fixing process

direction: down

start: Initialize Fix Queue {
  style.fill: "#0d6efd"
  style.font-color: white
  style.border-radius: 8
  label: "Initialize Fix Queue\nCRITICAL first, then HIGH"
}

counter: "Iteration Counter = 0" {
  style.fill: "#f8f9fa"
  style.stroke: "#dee2e6"
}

check_more: More issues? {
  shape: diamond
  style.fill: "#ffc107"
  style.font-color: "#212529"
}

check_max: Max iterations? {
  shape: diamond
  style.fill: "#ffc107"
  style.font-color: "#212529"
}

pop: Pop next issue {
  style.fill: "#f8f9fa"
  style.stroke: "#dee2e6"
  label: "Pop next issue\nfrom priority queue"
}

fix: Apply Fix {
  style.fill: "#0d6efd"
  style.font-color: white
  style.border-radius: 8
  label: "Apply automated fix\n- Edit files\n- Run formatters\n- Stage changes"
}

test: Run Tests {
  style.fill: "#f8f9fa"
  style.stroke: "#dee2e6"
}

pass: Mark Fixed {
  style.fill: "#198754"
  style.font-color: white
  style.border-radius: 8
  label: "Mark fixed\nRemove from queue"
}

fail: Rollback {
  style.fill: "#dc3545"
  style.font-color: white
  style.border-radius: 8
  label: "Rollback fix\nMark as failed"
}

increment: Increment iteration {
  style.fill: "#f8f9fa"
  style.stroke: "#dee2e6"
}

rerun: Re-run Review {
  style.fill: "#0d6efd"
  style.font-color: white
  style.border-radius: 8
  label: "Re-run Full Review\nVerify fixes worked"
}

summary: Generate Summary {
  style.fill: "#198754"
  style.font-color: white
  style.border-radius: 8
  label: "Generate Fix Summary\n- Issues resolved\n- Issues failed\n- Iterations used"
}

start -> counter
counter -> check_more

check_more -> pop: YES
check_more -> check_max: NO

check_max -> summary: YES
check_max -> pop: NO

pop -> fix
fix -> test
test -> pass: PASS
test -> fail: FAIL
pass -> increment
fail -> increment
increment -> check_more

summary -> rerun
